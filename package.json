{
  "name": "blockchain_web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "chain": "hardhat node --hostname 0.0.0.0",
    "deploy": "hardhat run scripts/deploy.js --network localhost",
    "deploy:game": "npx hardhat run scripts/deploy-game.js --network localhost",
    "deploy:beacon-lab": "npx hardhat run scripts/deploy-beacon-lab.js --network localhost",
    "beacon-lab": "node scripts/start-beacon-lab.js",
    "web": "cd frontend && npm run dev -- --host",
    "postinstall": "npm install --prefix frontend",
    "build": "npx hardhat compile && node scripts/copy-token-artifacts.js && npm run build --prefix frontend",
    "copy-token-artifacts": "node scripts/copy-token-artifacts.js",
    "test": "hardhat test",
    "test:pos": "hardhat test test/PoSScenarios.test.js",
    "test:contractlab": "hardhat test test/ContractLabScenarios.test.js",
    "test:game": "hardhat test test/game/PriceOracle.test.js test/game/GameController.test.js test/game/InspectionRegistry.test.js test/game/CarLot.test.js test/game/Bank.test.js test/game/Mixer.test.js test/game/Marketplace.test.js test/game/TokenFactory.test.js test/game/InsuranceDesk.test.js test/game/TimelockEscrow.test.js test/game/Integration.test.js test/game/BuyerSellerFlow.test.js",
    "verify": "node scripts/verify-connection.js",
    "lab1": "hardhat run scripts/cli-labs/1-explore-blockchain.js --network localhost",
    "lab2": "hardhat run scripts/cli-labs/2-sign-transaction.js --network localhost",
    "lab3": "hardhat run scripts/cli-labs/3-deploy-contract.js --network localhost",
    "lab4": "hardhat run scripts/cli-labs/4-query-data.js --network localhost",
    "lab5": "hardhat run scripts/cli-labs/5-validator-simulation.js --network localhost",
    "indexer": "node indexer/index.js",
    "terminal": "node server/terminal-server.js",
    "lab-api": "node server/lab-api.js",
    "console": "hardhat console --network localhost",
    "prepare-classroom": "node scripts/prepare-classroom.js",
    "reset": "node scripts/reset-classroom.js",
    "reset:docker": "docker compose down -v && docker compose up --build",
    "indexer:reset": "node -e \"const fs=require('fs'); const p='indexer/game.db'; if(fs.existsSync(p)) fs.unlinkSync(p);\" && node indexer/index.js",
    "bots": "npx hardhat run scripts/chain-city-bots.js --network localhost",
    "simulate": "node scripts/simulate-16-players.js",
    "simulate:epoch": "node scripts/simulate-epoch-actions.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "ethers": "^6.15.0",
    "hardhat": "^2.22.17"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^4.9.6",
    "better-sqlite3": "^12.6.2",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.19.0"
  }
}
